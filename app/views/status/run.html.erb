<% content_for :title, "Sync ##{@run.id} - Syncbridge" %>
<% if @run.status == "running" %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="3">
  <% end %>
<% end %>

<%= link_to "< Back to status", root_path, class: "back" %>

<div class="title-row">
  <h1>Sync #<%= @run.id %>: <%= @run.resource %></h1>
  <span class="badge <%= @run.status %>"><%= @run.status %></span>
</div>
<p class="sub">
  <% if @run.status == "running" %>
    Still running. This page refreshes every 3 seconds.
  <% else %>
    Finished <%= time_ago_in_words(@run.finished_at || @run.updated_at) %> ago.
  <% end %>
</p>

<div class="grid">
  <div class="card">
    <div class="label">Started</div>
    <div class="number" style="font-size: 18px;"><%= run_time(@run.started_at) %></div>
  </div>
  <div class="card">
    <div class="label">Finished</div>
    <div class="number" style="font-size: 18px;"><%= run_time(@run.finished_at) %></div>
  </div>
  <div class="card">
    <div class="label">Duration</div>
    <div class="number"><%= run_duration(@run) %></div>
  </div>
</div>

<div class="grid">
  <div class="card">
    <div class="label">Records fetched</div>
    <div class="number"><%= number_with_delimiter(@run.records_fetched) %></div>
  </div>
  <div class="card">
    <div class="label">Created</div>
    <div class="number"><%= number_with_delimiter(@run.records_created) %></div>
  </div>
  <div class="card">
    <div class="label">Updated</div>
    <div class="number"><%= number_with_delimiter(@run.records_updated) %></div>
  </div>
  <div class="card">
    <div class="label">Unchanged</div>
    <div class="number"><%= number_with_delimiter(@run.records_fetched - @run.records_created - @run.records_updated) %></div>
  </div>
</div>

<% if @run.error_message.present? %>
  <h2>Error</h2>
  <div class="error-box"><%= @run.error_message %></div>
<% end %>
