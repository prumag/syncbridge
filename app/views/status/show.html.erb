<% content_for :head do %>
  <meta http-equiv="refresh" content="5">
<% end %>

<h1>Syncbridge</h1>
<p class="sub">Data pulled from the client API into the local database. This page refreshes every 5 seconds.</p>

<div class="actions">
  <% SyncRun::RESOURCES.each do |resource| %>
    <% running = @latest_by_resource[resource]&.status == "running" %>
    <button type="button" class="sync-button" data-resource="<%= resource %>" <%= "disabled" if running %>>
      <%= running ? "Syncing #{resource}..." : "Sync #{resource} now" %>
    </button>
  <% end %>
  <span id="sync-message" class="small" role="status"></span>
</div>

<div class="grid">
  <div class="card">
    <div class="label">Attendees stored</div>
    <div class="number"><%= number_with_delimiter(@attendee_count) %></div>
  </div>
  <div class="card">
    <div class="label">Sessions stored</div>
    <div class="number"><%= number_with_delimiter(@session_count) %></div>
  </div>
  <div class="card">
    <div class="label">Speakers stored</div>
    <div class="number"><%= number_with_delimiter(@speaker_count) %></div>
  </div>
  <% @latest_by_resource.each do |resource, run| %>
    <div class="card">
      <div class="label">Last <%= resource %> sync</div>
      <% if run %>
        <div class="number"><span class="badge <%= run.status %>"><%= run.status %></span></div>
        <div class="small"><%= time_ago_in_words(run.started_at || run.created_at) %> ago</div>
      <% else %>
        <div class="number">Never</div>
        <div class="small">No sync has run yet</div>
      <% end %>
    </div>
  <% end %>
</div>

<h2>Recent syncs</h2>
<% if @runs.empty? %>
  <div class="empty">
    No syncs yet. Start one with <code>bin/rails 'sync:full[attendees]'</code>
    or <code>curl -X POST localhost:3000/sync_runs -d resource=attendees</code>
  </div>
<% else %>
  <table>
    <thead>
      <tr>
        <th>#</th><th>Resource</th><th>Status</th><th>Started</th>
        <th class="num">Duration</th><th class="num">Fetched</th><th class="num">Created</th><th class="num">Updated</th>
      </tr>
    </thead>
    <tbody>
      <% @runs.each do |run| %>
        <tr>
          <td><%= link_to run.id, run_path(run) %></td>
          <td><%= run.resource %></td>
          <td>
            <span class="badge <%= run.status %>"><%= run.status %></span>
            <% if run.error_message.present? %>
              <div class="error"><%= truncate(run.error_message, length: 120) %></div>
            <% end %>
          </td>
          <td><%= run_time(run.started_at) %></td>
          <td class="num"><%= run_duration(run) %></td>
          <td class="num"><%= number_with_delimiter(run.records_fetched) %></td>
          <td class="num"><%= number_with_delimiter(run.records_created) %></td>
          <td class="num"><%= number_with_delimiter(run.records_updated) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<footer>
  JSON endpoints: <a href="/sync_runs">/sync_runs</a> &middot; <a href="/attendees">/attendees</a>
</footer>

<script>
  document.querySelectorAll(".sync-button").forEach(function (button) {
    button.addEventListener("click", async function () {
      var message = document.getElementById("sync-message");
      var resource = button.dataset.resource;
      document.querySelectorAll(".sync-button").forEach(function (b) { b.disabled = true; });
      message.textContent = "Starting " + resource + " sync...";

      try {
        var response = await fetch("/sync_runs", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: "resource=" + encodeURIComponent(resource)
        });
        if (!response.ok) throw new Error("HTTP " + response.status);
        message.textContent = "Sync started. Updating...";
        setTimeout(function () { window.location.reload(); }, 1000);
      } catch (error) {
        message.textContent = "Could not start the sync (" + error.message + ").";
        document.querySelectorAll(".sync-button").forEach(function (b) { b.disabled = false; });
      }
    });
  });
</script>
